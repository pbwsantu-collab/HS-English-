{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"const fs = require('fs'); const out = '../docs/index.html'; const html = fs.readFileSync(out, 'utf8'); fs.writeFileSync('../docs/404.html', html);\"",
    "preview": "vite preview",
    "lint": "eslint --ext .ts,.tsx src || true",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.14.1",
    "zustand": "^5.0.8",
    "clsx": "^1.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.5.0",
    "vite": "^5.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.3.0",
    "postcss": "^8.4.31",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.46.0",
    "eslint-plugin-react": "^7.32.2",
    "vite-plugin-pwa": "^1.2.1"
  }
}